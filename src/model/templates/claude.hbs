{
  "env": {
    "ANTHROPIC_BASE_URL": {{json baseUrl}},
    "ANTHROPIC_AUTH_TOKEN": {{json apiKey}},
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": {{json (concat models.fast.id (contextSuffix models.fast.contextWindow))}},
    "ANTHROPIC_DEFAULT_SONNET_MODEL": {{json (concat models.default.id (contextSuffix models.default.contextWindow))}},
    "ANTHROPIC_DEFAULT_OPUS_MODEL": {{json (concat models.powerful.id (contextSuffix models.powerful.contextWindow))}},
    "ANTHROPIC_DEFAULT_FABLE_MODEL": {{json (concat models.powerful.id (contextSuffix models.powerful.contextWindow))}},
    {{#if models.fast.thinkingDisablable}}"MAX_THINKING_TOKENS": "0",
    {{/if}}"CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "HTTP_PROXY": "",
    "HTTPS_PROXY": "",
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1"
  },
  "model": {{json (concat models.default.id (contextSuffix models.default.contextWindow))}}{{#if pickerModels}},
  "modelPicker": {
    "options": [
      {{#each pickerModels}}{ "model": {{json (concat id (contextSuffix contextWindow))}} }{{#unless @last}},{{/unless}}{{/each}}
    ],
    "replaceBuiltInOptions": false
  }{{/if}}
}
