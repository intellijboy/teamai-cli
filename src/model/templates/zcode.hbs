{
  "model": {
    "main": {{json (concat provider "/" defaultModelId)}},
    "lite": {{json (concat provider "/" defaultModelId)}}
  },
  "provider": {
    {{json provider}}: {
      "name": {{json displayName}},
      "kind": {{#if (eq endpoint "anthropic")}}"anthropic"{{else}}"openai-compatible"{{/if}},
      "options": {
        "baseURL": {{json baseUrl}},
        "apiKey": {{json apiKey}},
        "apiKeyRequired": true
      },
      "models": {
        {{#each modelList}}
        {{json id}}: {
          "name": {{json id}}{{#if contextWindow}},
          "contextWindow": {{contextWindow}}{{/if}}
        }{{#unless @last}},{{/unless}}
        {{/each}}
      },
      "enabled": true
    }
  }
}
