{
  "models": [
    {{#each modelList}}
    {
      "id": {{json id}},
      "name": {{json id}},
      "vendor": {{json ../provider}},
      "apiKey": {{json ../apiKey}},
      {{#if contextWindow}}"maxInputTokens": {{contextWindow}},
      {{/if}}"maxOutputTokens": {{#if outputWindow}}{{outputWindow}}{{else}}4096{{/if}},
      "url": {{json (concat (trimSlash ../baseUrl) "/chat/completions")}},
      "supportsToolCall": true
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]
}
